# Claude Project Scanner Configuration
# Copy this file to .env and fill in your actual values

# GitGuardian API Key (required)  
# Create a Service Account Token with 'scan' and 'scan:create-incidents' permissions
# From: https://dashboard.gitguardian.com/settings/api/service-accounts
GITGUARDIAN_API_KEY=your_gitguardian_api_key_here

# Source UUID for BYOS (required)
# Create a custom source in your GitGuardian dashboard for secret scanning
# From: https://dashboard.gitguardian.com/sources
SOURCE_UUID=your_source_uuid_here

# Claude Projects Directory (optional, default: projects)
# Directory containing your Claude project files (.txt, .md, .json)
CLAUDE_PROJECTS_DIR=projects

# Force rescan all projects (optional, default: false)
# Set to 'true' to rescan all projects regardless of content hash
FORCE_RESCAN=false
