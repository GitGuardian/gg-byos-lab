# Dust API Configuration
DUST_API_KEY=your_dust_api_key_here
DUST_WORKSPACE_ID=your_dust_workspace_id_here

# GitGuardian API Configuration
GITGUARDIAN_API_KEY=your_gitguardian_api_key_here

# Source UUID for GitGuardian BYOS tracking
# Generate with: uuidgen (on macOS/Linux) or use any UUID generator
SOURCE_UUID=your_custom_source_uuid_here

# Optional: Force rescan all agents regardless of version
# Set to true to rescan agents even if they were already scanned
# FORCE_RESCAN=false
