# GitLab API Configuration
GITLAB_API_KEY=your_gitlab_personal_access_token_here

# GitLab Instance URL (for SaaS use https://gitlab.com, for on-premise use your instance URL)
# Examples: GITLAB_BASE_URL=https://gitlab.com or GITLAB_BASE_URL=https://gitlab.mycompany.com
GITLAB_BASE_URL=https://gitlab.com

# GitLab Authentication Method (PRIVATE-TOKEN or BEARER)
# Most GitLab instances prefer PRIVATE-TOKEN, GitLab.com supports both
# GITLAB_AUTH_METHOD=PRIVATE-TOKEN



# GitGuardian API Configuration
GITGUARDIAN_API_KEY=your_gitguardian_api_key_here

# Source UUID for GitGuardian BYOS tracking
# Generate with: uuidgen (on macOS/Linux) or use any UUID generator
SOURCE_UUID=your_custom_source_uuid_here

# Optional: Force rescan all snippets regardless of update timestamp
# Set to true to rescan snippets even if they were already scanned
# FORCE_RESCAN=false

# Optional: Debug mode to show snippet data structure
# Set to true to see detailed snippet information for debugging
# DEBUG_SNIPPETS=false
