# GitHub API Configuration
GITHUB_API_KEY=your_github_personal_access_token_here

# Optional: Target users to scan their public gists (comma-separated)
# If GITHUB_USERNAME is set, scans those users' public gists
# If GITHUB_USERNAME is not set, scans authenticated user's gists (including private)
# Examples: GITHUB_USERNAME=user1 or GITHUB_USERNAME=user1,user2,user3

# Optional: GitHub organizations to scan (comma-separated)
# Scans public gists of all public members in the specified organizations
# Examples: GITHUB_ORGS=myorg1,myorg2 or GITHUB_ORGS=my-company

# GitGuardian API Configuration
GITGUARDIAN_API_KEY=your_gitguardian_api_key_here

# Source UUID for GitGuardian BYOS tracking
# Generate with: uuidgen (on macOS/Linux) or use any UUID generator
SOURCE_UUID=your_custom_source_uuid_here

# Optional: Force rescan all gists regardless of update timestamp
# Set to true to rescan gists even if they were already scanned
# FORCE_RESCAN=false
